# Copy this file to .env and adjust if needed.
HOST=127.0.0.1
PORT=8000

# Where trained model files are stored (binary/ and multiclass/ subfolders)
MODEL_DIR=models

# Largest number of records accepted by one POST /predict call
MAX_RECORDS=5000

# Backend origin allowed to call this service
ALLOWED_ORIGIN=http://localhost:5000

# Shared secret with the backend (backend/.env ML_INTERNAL_KEY must be the same value). Leave empty only on your
# own machine. On any internet-facing host set a long random value AND ML_REQUIRE_KEY=true.
ML_INTERNAL_KEY=
ML_REQUIRE_KEY=false
