# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB. Local example below; for MongoDB Atlas paste your own connection string.
# The connection string contains a password, so it belongs only in .env.
MONGODB_URI=mongodb://localhost:27017/soc_assistant

# Auth. JWT_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# bcrypt cost factor (higher = slower and safer). 12 is a sensible default.
BCRYPT_ROUNDS=12

# Max login/register requests per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# CSV upload limits (optional; these are the defaults)
MAX_UPLOAD_MB=20
MAX_UPLOAD_ROWS=50000
ML_BATCH_SIZE=500
MAX_CONCURRENT_JOBS=2
UPLOAD_RATE_LIMIT_MAX=10
# UPLOAD_DIR=   (default: a "soc-uploads" folder inside your system temp directory)

# Number of reverse proxies in front of this server (nginx, load balancer). 0 = none (local development).
# Set it to 1 behind one proxy, or every user shares one rate limit and audit logs show the proxy's IP.
# Never set it higher than the real number: clients could then fake their IP.
TRUST_PROXY=0

# Allowed browser origin (the frontend dev server)
CORS_ORIGIN=http://localhost:5173

# URL of the Python ML service
ML_SERVICE_URL=http://localhost:8000

# URL of the Python AI service (knowledge search and the assistant)
AI_SERVICE_URL=http://localhost:8001
# Max assistant questions per IP per 15 minutes (each one may use language-model quota)
ASSISTANT_RATE_LIMIT_MAX=20
# Shared secret for the AI service. Must be EXACTLY the same as INTERNAL_API_KEY in ai-service/.env.
# Without it the assistant is refused. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_INTERNAL_KEY=replace-with-the-same-long-random-value
# The agent only SUGGESTS actions; every suggestion needs a person's approval. Set to false to turn it off.
AGENT_ENABLED=true
AGENT_PROPOSAL_TTL_DAYS=7
AGENT_RATE_LIMIT_MAX=30

# Let analysts choose to send an alert's raw row values (IPs, ports, ...) to the language model.
# They must tick a box for each question. Set to false to forbid it for everyone.
# Google's free-tier terms say not to submit personal or sensitive data, so think before leaving this on.
ASSISTANT_ALLOW_ROW_VALUES=true

# General chat: lets an analyst ask the language model anything (no reference documents, no sources, answers are
# unverified). Set to false to allow only the cited, document-based mode.
ASSISTANT_GENERAL_CHAT=true
