# Copy to .env. NEVER commit .env: it holds your API key.
ALLOWED_ORIGIN=http://localhost:5000

# --- knowledge search ---
# chroma = vector search (default). keyword = plain word matching, works with no extra packages.
RAG_STORE=chroma
# KNOWLEDGE_DIR=knowledge
# CHROMA_PATH=chroma_db
# RAG_MIN_SCORE=0

# --- language model (Phase 9) ---
# Leave LLM_API_KEY empty and the assistant only returns matching passages (no written answer).
# Get a key from Google AI Studio (https://aistudio.google.com/). The free tier has rate limits, and Google's
# free-tier terms may let Google use what you send, so do not send real company or personal data.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Model names change. If you get "model not found", choose a current one in Google AI Studio.
LLM_MODEL=gemini-3.8-flash
# LLM_TIMEOUT=30
# LLM_MAX_OUTPUT_TOKENS=700

# --- access control ---
# Shared secret between the backend and this service. Make a long random one, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The backend needs the SAME value in AI_INTERNAL_KEY. Without it, the /assistant/ endpoints refuse to work.
# At least 16 characters, and the placeholder below is refused on purpose.
INTERNAL_API_KEY=replace-me-with-a-long-random-value
